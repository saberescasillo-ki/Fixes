{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.fanim.player.root": {
      "initial_state": "first_person",
      "states": {
        "first_person": {
          "animations": [
            "first_person_base_pose",
            "first_person_breathing_bob",
            {
              "first_person_swap_item": "!query.blocking"
            },
            {
              "first_person_shield_block": "query.blocking"
            },
            {
              "first_person_attack_controller": "variable.attack_time > 0.0 && query.get_equipped_item_name != 'filled_map' && !variable.melee_spear_equipped"
            },
            {
              "first_person_empty_hand": "query.get_equipped_item_name(0, 1) != 'filled_map'"
            },
            {
              "first_person_walk": "variable.bob_animation"
            },
            {
              "first_person_map_controller": "query.get_equipped_item_name(0, 1) == 'filled_map' || query.get_equipped_item_name('off_hand') == 'filled_map'"
            },
            {
              "first_person_crossbow_equipped": "query.get_equipped_item_name == 'crossbow' && variable.item_use_normalized > 0.0 && variable.item_use_normalized < 1.0"
            },
            {
              "first_person_melee_spear_controller": "variable.melee_spear_equipped"
            }
          ],
          "transitions": [
            {
              "paperdoll": "variable.is_paperdoll"
            },
            {
              "map_player": "variable.map_face_icon"
            },
            {
              "third_person": "!variable.is_first_person"
            }
          ]
        },
        "map_player": {
          "transitions": [
            {
              "paperdoll": "variable.is_paperdoll"
            },
            {
              "first_person": "variable.is_first_person"
            },
            {
              "third_person": "!variable.map_face_icon && !variable.is_first_person"
            }
          ]
        },
        "paperdoll": {
          "animations": [
            "humanoid_base_pose",
            "look_at_target_ui",
            "move.arms",
            "move.legs",
            "cape"
          ],
          "transitions": [
            {
              "first_person": "!variable.is_paperdoll && variable.is_first_person"
            },
            {
              "map_player": "variable.map_face_icon"
            },
            {
              "third_person": "!variable.is_paperdoll && !variable.is_first_person"
            }
          ]
        },
        "third_person": {
          "animations": [
            "humanoid_base_pose",
            {
              "look_at_target": "!query.is_sleeping && !query.is_emoting"
            },
            "cape",
            {
              "riding.root": "query.is_riding"
            },
            {
              "riding.arms": "query.is_riding"
            },
            {
              "riding.legs": "query.is_riding"
            },
            {
              "charging": "query.is_charging"
            },
            {
              "damage_nearby_mobs": "variable.damage_nearby_mobs"
            },
            {
              "swimming": "variable.swim_amount > 0.0"
            },
            {
              "swimming.legs": "variable.swim_amount > 0.0"
            },
            {
              "crawling": "query.is_crawling"
            },
            {
              "crawling.legs": "query.is_crawling"
            },
            {
              "use_item_progress": "(query.item_remaining_use_duration <= 0.0 || (query.get_equipped_item_name == 'spyglass' || query.get_equipped_item_name == 'crossbow' || query.get_equipped_item_name == 'bow' || v.trident || query.get_equipped_item_name == 'fishing_rod' || query.get_equipped_item_name == 'potion') || !query.is_alive) && (query.item_remaining_use_duration <= 0.0 || (query.get_equipped_item_name != 'potion') || !query.is_alive) && (variable.use_item_interval_progress > 0.0 ) || ( variable.use_item_startup_progress > 0.0 ) && !variable.is_brandishing_spear && !variable.is_holding_spyglass && !variable.is_tooting_goat_horn && !variable.is_using_brush && !query.is_item_name_any('slot.weapon.mainhand', 'minecraft:bow')"
            },
            {
              "sleeping": "query.is_sleeping && query.is_alive"
            },
            {
              "attack.positions": "variable.attack_time >= 0.0 && !v.trident && !v.holding_sword && !v.holding_axe && !v.holding_pickaxe && !v.flint && !v.empty_hand && !v.holding_broadsword && !v.holding_spear && !v.knuckles && !v.holding_claymore && !v.holding_dual_dagger && !v.holding_halbert && !v.holding_halbert2 && !v.holding_dagger && !v.holding_greatsword && !v.holding_katana"
            },
            {
              "attack.rotations": "variable.attack_time >= 0.0 && !v.trident && !v.holding_sword && !v.holding_axe && !v.holding_pickaxe && !v.flint && !v.empty_hand && !v.holding_broadsword && !v.holding_spear && !v.knuckles && !v.holding_claymore && !v.holding_dual_dagger && !v.holding_halbert && !v.holding_halbert2 && !v.holding_dagger && !v.holding_greatsword && !v.holding_katana"
            },
            {
              "crossbow_controller": "query.get_equipped_item_name == 'crossbow'"
            },
            {
              "holding_heavy_core": "query.is_item_name_any('slot.weapon.mainhand', 'minecraft:heavy_core')"
            }
          ],
          "transitions": [
            {
              "paperdoll": "variable.is_paperdoll"
            },
            {
              "first_person": "variable.is_first_person"
            },
            {
              "map_player": "variable.map_face_icon"
            }
          ]
        }
      }
    }
  }
}
