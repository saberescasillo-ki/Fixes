{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "resonance:amethyst_glaive",
      "materials": {
        "default": "entity_alphatest_glint",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/amethyst_glaive",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.amethyst_glaive"
      },
      "animations": {
        "amethyst_glaive.idle": "animation.amethyst_glaive.idle"
      },
      "scripts": {
        "pre_animation": [
          "variable.amethyst_glaive = (query.is_in_ui || (variable.is_paperdoll ?? 0)) ? 0 : query.is_item_name_any('slot.weapon.mainhand', 0, 'resonance:amethyst_glaive');"
        ],
        "animate": [
          {
            "amethyst_glaive.idle": "!c.is_first_person && (variable.amethyst_glaive ?? 0)"
          }
        ],
        "initialize": [
          "variable.amethyst_glaive = 0.0;"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ],
      "item": {
        "resonance:amethyst_glaive": "(1.0)"
      }
    }
  }
}
