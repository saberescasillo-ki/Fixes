        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/echo_maul",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.echo_maul"
      },
      "animations": {
        "echo_maul.idle": "animation.echo_maul.idle"
      },
      "scripts": {
        "pre_animation": [
          "variable.echo_maul = (query.is_in_ui || (variable.is_paperdoll ?? 0)) ? 0 : query.is_item_name_any('slot.weapon.mainhand', 0, 'resonance:echo_maul');"
        ],
        "animate": [
          {
            "echo_maul.idle": "!c.is_first_person && (variable.echo_maul ?? 0)"
          }
        ],
        "initialize": [
          "variable.echo_maul = 0.0;"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ],
