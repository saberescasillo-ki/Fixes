      "materials": {
        "default": "entity_alphatest_glint",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/blaze_scimitar",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.blaze_scimitar"
      },
      "animations": {
        "blaze_scimitar.idle": "animation.blaze_scimitar.idle"
      },
      "scripts": {
        "pre_animation": [
          "variable.blaze_scimitar = (query.is_in_ui || (variable.is_paperdoll ?? 0)) ? 0 : query.is_item_name_any('slot.weapon.mainhand', 0, 'resonance:blaze_scimitar');"
        ],
        "animate": [
          {
            "blaze_scimitar.idle": "!c.is_first_person && (variable.blaze_scimitar ?? 0)"
          }
        ],
        "initialize": [
          "variable.blaze_scimitar = 0.0;"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ],
      "item": {
        "resonance:blaze_scimitar": "(1.0)"
      }
    }
  }
}
