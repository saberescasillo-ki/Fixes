				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"1" : "q.is_sprinting && !q.is_sneaking && query.all_animations_finished && v.holding_katana && !variable.attack && query.modified_move_speed>0.1"
						},
						{
							"2" : "!q.is_sprinting && !q.is_sneaking && query.all_animations_finished && v.holding_katana && !variable.attack && query.modified_move_speed>0.1"
						}
					]
				},
