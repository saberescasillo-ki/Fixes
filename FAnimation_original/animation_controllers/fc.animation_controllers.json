					"animations" : [ {"holding_katana1":"!v.is_first_person && !query.is_riding && !q.is_gliding && !q.is_in_water"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "(!q.is_sprinting || q.is_sneaking || !q.all_animations_finished || !v.holding_katana || query.modified_move_speed<0.1 || variable.attack)"
						},
