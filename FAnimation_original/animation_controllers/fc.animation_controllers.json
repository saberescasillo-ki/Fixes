					"transitions": [
						{
							"1" : "!q.is_first_person && !query.is_on_ground && query.ground_speed>13 && !query.is_sprinting && !query.is_in_water && !query.is_gliding"
						},
						{
						    "2" : "!q.is_first_person && !query.is_on_ground && query.ground_speed>13 && !query.is_sprinting && !query.is_in_water && query.is_gliding"
						}
					]
				},
				"1": {
					"animations": [
						{"fall_bs":"!v.is_first_person && v.holding_broadsword"}
					],
					"blend_transition": 0.4,
					"transitions": [
						{
							"2": "!q.is_first_person && query.is_on_ground && query.ground_speed<13 && !query.is_in_water"
						},
						{
							"default": "!q.is_first_person && (!query.is_on_ground && query.ground_speed<13) || query.is_in_water"
						}
					]
				},
				"2": {
