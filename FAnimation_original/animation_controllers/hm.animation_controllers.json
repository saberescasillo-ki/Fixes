					"animations" : [ {"sneaking": "!v.is_first_person"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "!q.is_sneaking || v.holding_katana || v.holding_broadsword || v.kneeling1 || v.sitting1 || v.flowerr || q.is_crawling || v.sitting_new1 || v.sleep1"
						}
					]
