			"controller.animation.use_boots": {
			  "states": {
				"2": {
				  "animations": [{"use_boots":"q.is_alive"}],
				  "blend_transition": 0,
				  "transitions": [
					{
					  "1": "query.is_item_name_any('slot.armor.feet', 0, '')"
					}
				  ]
				},
				"default": {
				  "blend_transition": 0,
				  "transitions": [
