			"controller.animation.player.fishing":{
				 "states":{
					"default":{
					   "transitions":[
						  {
							 "1":"query.get_equipped_item_name == 'fishing_rod' && !q.is_moving"
						  }
					   ],
					   "blend_transition":0.4
					},
					"1":{
					   "animations":[
						  "fish"
					   ],
					   "transitions":[
						  {
							 "default":"query.get_equipped_item_name != 'fishing_rod' || q.is_moving"
						  }
					   ],
					   "blend_transition":0.2
					}
			  }
		   },
			  "controller.animation.player.fishing1":{
				 "states":{
					"default":{
					   "transitions":[
						  {
							 "2":"query.get_equipped_item_name == 'fishing_rod' && query.item_in_use_duration > 0"
						  }
					   ]
					},
					"2":{
					   "animations":[
						  "fish1"
					   ],
					   "transitions":[
						  {
							 "default":"query.all_animations_finished || query.get_equipped_item_name != 'fishing_rod'"
						  }
					   ]
					}
				 }
			  },
			"controller.animation.player.crossbow" : {
			"initial_state" : "default",
			"states" : {
				"charge" : {
					"animations" : [ "third_person_crossbow_equipped" ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "query.get_equipped_item_name != 'crossbow' || (query.item_remaining_use_duration <= 0.0 && !query.item_is_charged)"
						},
						{
							"hold" : "query.item_is_charged"
						}
					]
				},
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"hold" : "query.item_is_charged"
						},
						{
							"charge" : "query.item_remaining_use_duration > 0.0"
						}
					]
				},
				"hold" : {
					"animations" : [ "crossbow_hold" ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "query.get_equipped_item_name != 'crossbow' || (query.item_remaining_use_duration <= 0.0 && !query.item_is_charged)"
						},
						{
							"charge" : "query.item_remaining_use_duration > 0.0"
						}
					]
				}
			}
		},
		"controller.animation.player.custom_holding" : {
			"initial_state" : "default",
			"states" : {
				"right" : {
					"animations" : [ {"45r":"!v.is_first_person"},{"45l":"!v.is_first_person && v.map_holding_left"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "!v.map_holding_right"
						},
						{
							"left" : "v.map_holding_left"
						},
						{
							"both" : "v.map_holding"
						}
					]
				},
				"left" : {
					"animations" : [ {"45l":"!v.is_first_person && !q.item_is_charged && !v.using_bow"},{"45r":"!v.is_first_person && v.map_holding_right"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "!v.map_holding_left"
						},
						{
							"right" : "v.map_holding_right"
						},
						{
							"both" : "v.map_holding"
						}
					]
				},
				"both" : {
					"animations" : [ {"55b":"!v.is_first_person"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "!v.map_holding"
						},
						{
							"right" : "v.map_holding_right"
						},
						{
							"left" : "v.map_holding_left"
						}
					]
				},
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"right" : "v.map_holding_right"
						},
						{
							"left" : "v.map_holding_left"
						},
						{
							"both" : "v.map_holding"
						}
					]
				}
			}
		},
		"controller.animation.player.holding" : {
			"initial_state" : "default",
			"states" : {
				"hr" : {
					"animations" : [ {"hr":"!v.is_first_person && !v.holding_sword && !v.map_holding_right && !v.hc && !v.map_holding && (query.item_remaining_use_duration <= 0.0 && !q.item_is_charged) && !v.using_bow && !v.holding_spear && !v.holding_broadsword"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "!variable.is_holding_right"
						}
					]
				},
				"default" : {
					"animations" : [ {"default_items":"!v.is_first_person"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"hr" : "variable.is_holding_right"
						}
					]
				}
			}
		},
		"controller.animation.item.sword" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"1" : "variable.holding_sword"
						},
						{
							"2" : "variable.holding_katana"
						}
					]
				},
				"1" : {
					"animations" : [ {"item.sword":"!v.is_first_person"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "query.all_animations_finished && !variable.holding_sword"
						},
						{
							"2" : "variable.holding_katana"
						}
					]
				},
				"2" : {
					"animations" : [ {"item.katana":"!v.is_first_person"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "query.all_animations_finished && !variable.holding_katana"
						},
						{
							"1" : "variable.holding_sword"
						}
					]
				}
			}
		},
		"controller.animation.player.holding_spyglass" : {
			"initial_state" : "default",
			"states" : {
				"7" : {
					"animations" : [ {"holding_spyglass":"!v.is_first_person"} ],
					"blend_transition": 0.1,
					"transitions" : [
						{
							"default" : "!variable.is_holding_spyglass"
						}
					]
				},
				"default" : {
					"blend_transition": 0.1,
					"transitions" : [
						{
							"7" : "variable.is_holding_spyglass"
						}
					]
				}
			}
		},
