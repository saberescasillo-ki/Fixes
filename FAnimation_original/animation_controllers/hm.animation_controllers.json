{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.player.bob" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ {"bob":"!v.is_first_person && !q.is_sleeping && !q.is_riding"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "!q.is_alive || variable.is_holding_spyglass || variable.is_tooting_goat_horn || variable.is_using_brush || v.map_holding || v.holding_broadsword || v.holding_spear || v.holding_halbert || v.holding_halbert2 || v.holding_greatsword || query.modified_move_speed > 0.08 || q.is_sneaking || v.attack || q.is_using_item || q.item_is_charged || !q.is_on_ground"
						}
					]
				},
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"1" : "q.is_alive && !variable.is_holding_spyglass && !variable.is_tooting_goat_horn && !variable.is_using_brush && !v.map_holding && !v.holding_broadsword && !v.holding_spear && !v.holding_halbert && !v.holding_halbert2 && !v.holding_greatsword && query.modified_move_speed < 0.08 && !q.is_sneaking && !v.attack && !q.is_using_item && !q.item_is_charged && q.is_on_ground"
						}
						]
					}
				}
			},
			"controller.animation.player.fly.bob" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ "fly_bob" ],
					"blend_transition": 0.4,
					"transitions" : [
						{
							"default" : "!q.is_alive || !query.is_on_screen || query.is_sleeping || variable.is_first_person || query.is_sprinting || query.is_in_water || query.is_riding || query.is_gliding || query.is_on_ground || query.modified_move_speed > 0.99"
						}
					]
				},
				"default" : {
					"blend_transition": 0.4,
					"transitions" : [
						{
							"1" : "q.is_alive && query.is_on_screen && !query.is_sleeping && !variable.is_first_person && !query.is_sprinting && !query.is_in_water && !query.is_riding && !query.is_gliding && !query.is_on_ground && query.modified_move_speed < 0.99"
						}
						]
					}
				}
			},
			"controller.animation.player.fly.move" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ "fly_move" ],
					"blend_transition": 0.4,
					"transitions" : [
						{
							"default" : "!q.is_alive || !query.is_on_screen || query.is_sleeping || variable.is_first_person || query.is_in_water || query.is_riding || query.is_gliding || query.is_on_ground || query.modified_move_speed<0.99 || q.is_sprinting"
						}
					]
				},
				"default" : {
					"blend_transition": 0.4,
					"transitions" : [
						{
							"1" : "q.is_alive && query.is_on_screen && !query.is_sleeping && !variable.is_first_person && !query.is_in_water && !query.is_riding && !query.is_gliding && !query.is_on_ground && query.modified_move_speed>0.99 && !q.is_sprinting"
						}
						]
					}
				}
			},
			"controller.animation.player.fly.sprint" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ "fly_sprint" ],
					"blend_transition": 0.4,
					"transitions" : [
						{
							"default" : "!q.is_alive || !query.is_on_screen || query.is_sleeping || variable.is_first_person || query.is_in_water || query.is_riding || query.is_gliding || query.is_on_ground || query.modified_move_speed<0.99 || !q.is_sprinting"
						}
					]
				},
				"default" : {
					"blend_transition": 0.4,
					"transitions" : [
						{
							"1" : "q.is_alive && query.is_on_screen && !query.is_sleeping && !variable.is_first_person && !query.is_in_water && !query.is_riding && !query.is_gliding && !query.is_on_ground && query.modified_move_speed>0.99 && q.is_sprinting"
						}
						]
					}
				}
			},
			"controller.animation.player.walk" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ {"walk.arms":"!v.map_holding && !v.is_first_person && !v.broadsword_slow"},{"walk.legs":"!v.broadsword_slow"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "v.is_first_person || query.is_using_item || query.modified_move_speed < 0.08 || q.is_sprinting ||  !query.is_on_ground || query.is_sneaking || query.is_riding || !query.is_alive || query.is_sleeping || query.is_gliding"
						}
					]
				},
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"1" : "!v.is_first_person && !query.is_using_item && query.modified_move_speed > 0.08 && !q.is_sprinting && query.is_on_ground && !query.is_sneaking && !query.is_riding && !query.is_in_water && query.is_alive && !query.is_sleeping && !query.is_gliding"
						}
						]
					}
				}
			},
			"controller.animation.player.run" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ {"run.arms":"!v.map_holding && !v.is_first_person"},{"run.legs":"!v.is_first_person"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "query.modified_move_speed < 0.3 || !query.is_sprinting || !query.is_on_ground || query.is_sneaking || query.is_riding || !query.is_alive || query.is_sleeping || query.is_gliding"
						}
					]
				},
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"1" : "query.modified_move_speed > 0.3 && query.is_sprinting && query.is_on_ground && !query.is_sneaking && !query.is_riding && !query.is_in_water && query.is_alive && !query.is_sleeping && !query.is_gliding"
						}
						]
					}
				}
			},
			"controller.animation.player.sneak" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ {"sneak.arms":"!v.map_holding && !v.is_first_person && !v.swim_idle && !v.holding_halbert2 && !v.holding_katana"},{"sneak.legs":"!v.is_first_person && !v.swim_idle"} ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "(!query.is_sneaking || query.modified_move_speed < 0.01 || query.is_sleeping || query.is_gliding || !query.is_sneaking || !query.is_on_ground) && (!query.is_in_water || query.is_swimming)"
						}
					]
				},
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"1" : "(query.is_sneaking && query.modified_move_speed > 0.01 && !query.is_sleeping && !query.is_gliding && query.is_sneaking && query.is_on_ground) || (query.is_in_water && !query.is_swimming)"
						}
						]
					}
				}
			},
			"controller.animation.player.move_using_items" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ "sneak.legs" ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "!v.move_using_items|| query.modified_move_speed < 0.08 "
						}
					]
				},
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"1" : "v.move_using_items && query.modified_move_speed > 0.08 "
						}
						]
					}
				}
			},
			"controller.animation.player.broadsword_slow" : {
			"initial_state" : "default",
			"states" : {
				"1" : {
					"animations" : [ "sneak.legs" ],
					"blend_transition": 0.2,
					"transitions" : [
						{
							"default" : "!v.broadsword_slow || query.modified_move_speed < 0.01 || q.is_sneaking"
						}
					]
				},
				"default" : {
					"blend_transition": 0.2,
					"transitions" : [
						{
							"1" : "v.broadsword_slow && query.modified_move_speed > 0.01 && !q.is_sneaking "
						}
						]
					}
				}
			},
			"controller.animation.use_helmet": {
			  "states": {
				"2": {
				  "animations": [{"use_helmet":"q.is_alive"}],
				  "blend_transition": 0,
				  "transitions": [
					{
					  "1": "query.is_item_name_any('slot.armor.head', 0, '')"
					}
				  ]
				},
				"default": {
				  "blend_transition": 0,
				  "transitions": [
					{
					  "2": "!query.is_item_name_any('slot.armor.head', 0, '')"
					}
				  ]
				},
				"1": {
				  "animations": ["use_helmet2"],
				  "blend_transition": 0,
				  "transitions": [
					{
					  "default": "query.all_animations_finished"
					}
				  ]
				}
			  }
			},
			"controller.animation.use_armor": {
			  "states": {
				"2": {
				  "animations": [{"use_armor":"q.is_alive"}],
