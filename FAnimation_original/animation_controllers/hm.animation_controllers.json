						}
					]
				}
			}
		},
		"controller.animation.player.kneeling" : {
			"initial_state" : "default",
			"states" : {
				"8" : {
					"animations" : [ {"kneeling": "!v.is_first_person"} ],
					"blend_transition": 0.4,
					"transitions" : [
						{
							"default" : "!variable.kneeling || !q.is_sneaking || query.modified_move_speed > 0.08"
						}
					]
				},
				"default" : {
					"blend_transition": 0.4,
					"transitions" : [
						{
							"8" : "variable.kneeling && q.is_sneaking && !q.is_sleeping && query.modified_move_speed < 0.08"
						}
					]
				}
			}
		},
		"controller.animation.player.sleep" : {
			"initial_state" : "default",
			"states" : {
				"8" : {
					"animations" : [ 
					{"sleep": "!v.is_first_person && v.roll == 1"},
					{"sleep1": "!v.is_first_person && v.roll == 2"}
					],
					"blend_transition": 0.3,
					"transitions" : [
						{
							"default" : "!variable.sleep || !q.is_sneaking || query.modified_move_speed > 0.08"
						}
					]
				},
				"default" : {
					"on_entry": ["v.roll = math.random_integer(1, 2);"],
					"on_exit": [ "v.roll = math.random_integer(1, 2);"],
					"blend_transition": 0.4,
					"transitions" : [
						{
							"8" : "variable.sleep && q.is_sneaking && !q.is_sleeping && query.modified_move_speed < 0.08"
						}
					]
				}
			}
		},
		"controller.animation.player.sitting_new" : {
			"initial_state" : "default",
			"states" : {
				"8" : {
